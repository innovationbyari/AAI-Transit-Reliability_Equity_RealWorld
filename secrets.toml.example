# Copy these lines into Streamlit Community Cloud → your app → Settings → Secrets (fill in your values).
# Locally: copy this file to .streamlit/secrets.toml. Never commit secrets.toml (it is in .gitignore).

# --- Required: NJ Transit developer account (developer.njtransit.com). Without it there are no cases
#     (the v7 engine only opens cases from live buses in this dashboard). ---
NJ_TRANSIT_USERNAME = ""
NJ_TRANSIT_PASSWORD = ""

# --- Strongly recommended: protects the public URL (it spends your API keys) ---
DASHBOARD_PASSWORD = ""

# --- Step 2 · The team (optional: these are the defaults) ---
# DISPATCHER_NAME = "Ariyan"        # 1st reviewer
# SUPERVISOR_NAME = "Terri-Ann"     # 2nd reviewer
# OFFICER_NAME = "Grant"            # carries out the action, alerts the driver
# DRIVER_NAME = "Bus Driver"        # receives the alert
# TEAM_TRAINING_DATE = "2026-11-16" # all four ethics trainings recorded as completed on this date
# REQUIRE_SUPERVISOR_APPROVAL = "1" # "1" = every action needs the supervisor; "0" = only high-impact actions

# --- Driver text message (Twilio). Without these, alerts still appear on the driver screen. ---
TWILIO_ACCOUNT_SID = ""             # starts with AC…  (Twilio Console → Account info)
TWILIO_AUTH_TOKEN = ""
TWILIO_FROM_NUMBER = ""             # your Twilio number, e.g. "+18005550123" (must be verified toll-free or A2P-registered)
# TWILIO_MESSAGING_SERVICE_SID = "" # alternative to TWILIO_FROM_NUMBER (starts with MG…)
DRIVER_PHONE_NUMBER = ""            # the driver's phone, e.g. "+19735551234" (trial accounts: must be a Verified Caller ID)

# --- Map: CARTO street basemap (free key: https://carto.com/basemaps/apikey). Without it: OpenStreetMap tiles. ---
CARTO_API_KEY = ""
# CARTO_STYLE = "voyager"      # "voyager" (default, clearest street names), "positron" (light) or "dark-matter"

# --- Optional live data ---
CENSUS_API_KEY = ""
NWS_CONTACT_EMAIL = ""         # identifies the app to the National Weather Service

# --- Optional LLM narratives (deterministic templates are used without a key) ---
OPENAI_API_KEY = ""
# OPENROUTER_API_KEY = ""
# HF_API_KEY = ""
# LLM_PROVIDER = "openai"
# LLM_MAX_CALLS = "300"

# --- Needed before anyone can Approve: your real reviewers and their ethics training (JSON) ---
# The team (Step 2) is always on the roster. Add more people with:
# REVIEWER_ROSTER_JSON = '''[{"name": "...", "department": "...", "completed": ["conflicts", "transparency", "procurement", "data_protection"], "last_training": "YYYY-MM-DD"}]'''
# STAFF_DISCLOSURES_JSON = '''{"Name": {"text": "...", "facts": {"official_name": "Name", "role": "...", "holdings": [], "relationships": []}}}'''

# --- Optional: v7's camera model and FLAN-T5 language model (need requirements-ml.txt, ~1.5 GB memory) ---
# USE_CV = "true"
# USE_SLM = "true"

# --- Optional settings ---
# NJT_GTFS_ZIP = ""            # URL or path to the bus GTFS zip, if getGTFS is not enabled on your NJ Transit account
# NJT_NEARBY_KM = "2.0"        # radius for live vehicles and the routes drawn on the map
# SERVICE_AREA_LAT = "40.7347" # default: Newark Penn Station
# SERVICE_AREA_LON = "-74.1642"
